[Unit]
Description=BLUEKVM PANNEL background provisioning worker
Documentation=https://github.com/siddhantpashte123-hub/BKUEKVM-
After=network-online.target postgresql.service libvirtd.service virtqemud.service bluekvm-api.service
Wants=network-online.target

[Service]
Type=simple
User=bluekvm
Group=libvirt
WorkingDirectory=/opt/bluekvm/backend
EnvironmentFile=/opt/bluekvm/.env
ExecStart=/opt/bluekvm/backend/.venv/bin/python -m app.services.worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/bluekvm /var/log/bluekvm
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
