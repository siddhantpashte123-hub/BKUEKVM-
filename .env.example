# =====================================================================
# BLUEKVM PANNEL — environment configuration template
# Copy to .env and fill in real values. NEVER commit the real .env.
# =====================================================================

# Web / API
BLUEKVM_ENV=production                 # development | production
BLUEKVM_HOST=0.0.0.0
BLUEKVM_PORT=8080
BLUEKVM_PUBLIC_URL=https://panel.example.com:8080
BLUEKVM_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# Database (PostgreSQL recommended in production)
DATABASE_URL=postgresql+psycopg://bluekvm:STRONG_PASSWORD@127.0.0.1:5432/bluekvm
# Development fallback (no Postgres required):
# DATABASE_URL=sqlite:///./data/bluekvm.db

# Initial administrator (created by installer / first bootstrap only)
BLUEKVM_ADMIN_USERNAME=admin
BLUEKVM_ADMIN_EMAIL=admin@example.com
# Leave empty to generate a random password printed once by the installer
BLUEKVM_ADMIN_PASSWORD=

# Session security
BLUEKVM_SESSION_TTL_MINUTES=720
BLUEKVM_COOKIE_SECURE=1                 # 1 = HTTPS only (set 0 for plain-HTTP dev)
BLUEKVM_CSRF_ENABLED=1

# Rate limiting
BLUEKVM_LOGIN_RATE_PER_MINUTE=8

# Virtualization
BLUEKVM_LIBVIRT_URI=qemu:///system
BLUEKVM_VM_STORAGE_DIR=/var/lib/bluekvm/vms
BLUEKVM_TEMPLATE_DIR=/var/lib/bluekvm/templates
BLUEKVM_BACKUP_DIR=/var/lib/bluekvm/backups
# Bridge used for VM networking (e.g. br0). Empty = default NAT network.
BLUEKVM_DEFAULT_BRIDGE=
BLUEKVM_DEFAULT_NETWORK=default

# Logging
BLUEKVM_LOG_LEVEL=INFO
BLUEKVM_LOG_DIR=/var/log/bluekvm

# Credential encryption key for remote node URIs (Fernet key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BLUEKVM_CREDENTIAL_KEY=CHANGE_ME_fernet_key
